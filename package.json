{
  "name": "science-video-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Manifest-driven science explainer videos built with Remotion.",
  "type": "module",
  "scripts": {
    "dev": "remotion studio --no-open",
    "studio": "remotion studio --no-open",
    "validate": "tsx scripts/validate.ts",
    "validate-shots": "tsx scripts/validate-shots.ts",
    "preview": "tsx scripts/preview.ts",
    "render": "tsx scripts/render.ts",
    "prepare-assets": "tsx scripts/prepare-assets.ts",
    "still": "tsx scripts/still.ts",
    "new-episode": "tsx scripts/new-episode.ts",
    "delete-episode": "tsx scripts/delete-episode.ts",
    "generate-registry": "tsx scripts/generate-registry.ts",
    "validate-all": "tsx scripts/validate-all.ts",
    "test": "npm run generate-registry && npm run typecheck && npm run validate-all && npm run test:default && npm run test:delete-episode && npm run test:storyboard && npm run test:captions",
    "test:default": "tsx scripts/test-default-entry.ts",
    "test:delete-episode": "tsx scripts/test-delete-episode.ts",
    "test:storyboard": "tsx scripts/test-storyboard.ts",
    "test:captions": "tsx scripts/test-captions.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/player": "4.0.535",
    "remotion": "4.0.535",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "4.5.4"
    ,"gsap": "3.14.2"
    ,"hyperframes": "0.8.161"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
