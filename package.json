{
  "name": "science-video-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Manifest-driven science explainer videos built with Remotion.",
  "type": "module",
  "scripts": {
    "dev": "remotion studio --no-open",
    "studio": "remotion studio --no-open",
    "validate": "tsx scripts/commands/validate.ts",
    "validate-planning": "tsx scripts/commands/validate-planning.ts",
    "validate-shots": "tsx scripts/commands/validate-shots.ts",
    "author-shots": "tsx scripts/commands/author-shots.ts",
    "preview-shots": "tsx scripts/commands/preview-shots.ts",
    "render-shots": "tsx scripts/commands/render-shots.ts",
    "verify-output": "tsx scripts/commands/verify-output.ts",
    "preview": "tsx scripts/commands/preview.ts",
    "render": "tsx scripts/commands/render.ts",
    "prepare-assets": "tsx scripts/commands/prepare-assets.ts",
    "still": "tsx scripts/commands/still.ts",
    "contact-sheet": "tsx scripts/commands/contact-sheet.ts",
    "visual-regression": "tsx scripts/commands/visual-regression.ts",
    "new-episode": "tsx scripts/commands/new-episode.ts",
    "delete-episode": "tsx scripts/commands/delete-episode.ts",
    "generate-registry": "tsx scripts/commands/generate-registry.ts",
    "validate-all": "tsx scripts/commands/validate-all.ts",
    "test": "npm run generate-registry && npm run typecheck && npm run validate-all && npm run test:default && npm run test:delete-episode && npm run test:storyboard && npm run test:captions",
    "test:default": "tsx scripts/tests/test-default-entry.ts",
    "test:delete-episode": "tsx scripts/tests/test-delete-episode.ts",
    "test:storyboard": "tsx scripts/tests/test-storyboard.ts",
    "test:captions": "tsx scripts/tests/test-captions.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/player": "4.0.535",
    "remotion": "4.0.535",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "4.5.4"
    ,"gsap": "3.14.2"
    ,"hyperframes": "0.8.161"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
